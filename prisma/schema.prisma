generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  username          String   @unique
  depositAddress    String   @unique
  depositPrivateKey String?  // chave privada AES-256-GCM criptografada (formato "iv:tag:encrypted")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Saldos internos
  balanceCrate      Float    @default(0)
  balanceSol        Float    @default(0)
  balanceLc         Float    @default(0)

  // Expansões de inventário
  slotsRobots       Int      @default(10)
  slotsEquipments   Int      @default(20)
  slotsBaseUpgrades Int      @default(10)
  slotsParts        Int      @default(50)
  slotsConsumables  Int      @default(20)
  slotsLootboxes    Int      @default(10)

  // Outpost
  outpostSlots      Int      @default(3)

  // Alocação de mineração (soma deve ser 100)
  allocationCrate   Float    @default(100)
  allocationSol     Float    @default(0)
  allocationLc      Float    @default(0)

  // Relações
  robots            Robot[]
  equipments        Equipment[]
  baseUpgrades      BaseUpgrade[]
  parts             InventoryPart[]
  consumables       Consumable[]
  lootboxes         InventoryLootbox[]
  transactions      Transaction[]
  withdrawRequests  WithdrawRequest[]
  marketListings    MarketListing[]
  marketPurchases   MarketPurchase[]
  miningRewards     MiningReward[]
  codexEntries      CodexEntry[]
  missions          UserMission[]
  minigameSessions      MinigameSession[]
  minigameBoosts        MinigameBoost[]     // N entradas independentes por vitória
  minigameStatuses      MinigameStatus[]
  totalMinigameWins     Int               @default(0) // lifetime wins (stat histórico)
  minigameStreakWins    Int               @default(0) // vitórias consecutivas sem gap de 24h
  lastMinigameWinAt     DateTime?                     // última vitória — detecta quebra de streak
  // Cooldown global (compartilhado entre todos os jogos)
  globalGamesPlayedToday Int             @default(0) // total de partidas hoje (todos os jogos)
  globalLastPlayedAt    DateTime?                     // última partida — para redução regressiva
  globalLastResetAt     DateTime         @default(now()) // reset de 24h
  globalNextPlayableAt  DateTime?                     // quando pode jogar novamente
  weeklyDrops       WeeklyDrop[]
  notifications     Notification[]
  pendingCrafts     PendingCraft[]

  // Ranking semanal — acumula ER contribuído nesta semana; resetado toda segunda
  weeklyErContributed Float @default(0)

  // Perfil público
  profilePublic  Boolean  @default(true)
  bio            String?  @db.VarChar(200)
  avatarUrl      String?
  equippedTitle  String?
  titles         UserTitle[]

  // Admin
  isAdmin             Boolean  @default(false)
  isBanned            Boolean  @default(false)

  @@map("users")
}

// ─────────────────────────────────────────────
// TÍTULOS DO JOGADOR
// ─────────────────────────────────────────────

model UserTitle {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  title    String
  source   String   // 'MISSION' | 'CODEX'
  earnedAt DateTime @default(now())

  @@unique([userId, title])
  @@map("user_titles")
}

// ─────────────────────────────────────────────
// ROBÔS
// ─────────────────────────────────────────────

model Robot {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])

  // Referência ao template (ShopItem category='robot-specific')
  // Quando o template é editado, todos os robôs com esse templateId são atualizados
  templateId    String?     // null = robô gerado aleatoriamente (sem template fixo)

  // Cache do template — atualizados automaticamente quando o template muda
  name          String
  collection    String      // ex: "Sentinel — Standard Series"
  rarity        Rarity
  hashPower     Float       // Extraction Rate (ER) base
  energyRate    Float       @default(1)   // Power Draw (PD) — consumo de energia por hora

  // Por instância — estado individual do robô
  maxDurability Float?                   // valor base do template (para calcular % de desgaste)
  durability    Float       @default(100) // valor atual (absoluto, não %)
  isActive      Boolean     @default(false) // ativo no Outpost
  outpostSlot   Int?        // slot ocupado (1-6)
  inCodex       Boolean     @default(false) // permanentemente registrado no Codex
  createdAt     DateTime    @default(now())

  equipments    RobotEquipment[]
  codexEntry    CodexEntry?
  listing       MarketListing?

  @@index([userId, isActive])   // mining queries + outpost
  @@map("robots")
}

model RobotEquipment {
  id          String    @id @default(uuid())
  robotId     String
  robot       Robot     @relation(fields: [robotId], references: [id])
  equipmentId String    @unique
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  installedAt DateTime  @default(now())

  @@map("robot_equipments")
}

// ─────────────────────────────────────────────
// EQUIPAMENTOS
// ─────────────────────────────────────────────

model Equipment {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])

  name         String
  collection   String?       // tag de coleção do Codex (opcional)
  rarity       Rarity
  effectType   EffectType
  effectValue  Float
  effectType2  EffectType?   // efeito secundário (ex: equipamento ER + PD)
  effectValue2 Float?
  isPermanent  Boolean        @default(false)
  expiresAt    DateTime?
  createdAt    DateTime       @default(now())

  robot        RobotEquipment?
  codexEntry  CodexEntry?
  listing     MarketListing?

  @@map("equipments")
}

// ─────────────────────────────────────────────
// MELHORIAS DE BASE
// ─────────────────────────────────────────────

model BaseUpgrade {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])

  name         String
  collection   String?      // tag de coleção do Codex (opcional)
  rarity       Rarity
  effectType   EffectType
  effectValue  Float
  effectType2  EffectType?  // efeito secundário
  effectValue2 Float?
  isApplied    Boolean       @default(false)
  appliedSlot  Int?          // 1 = Mining Power, 2 = Energy Reduction
  createdAt   DateTime      @default(now())

  codexEntry  CodexEntry?
  listing     MarketListing?

  @@map("base_upgrades")
}

// ─────────────────────────────────────────────
// PEÇAS DE CRAFTING
// ─────────────────────────────────────────────

model InventoryPart {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  partType  String   // ex: "Broca de titanio"
  category  PartCategory
  rarity    Rarity
  quantity  Int      @default(1) // stack até 99

  @@unique([userId, partType])
  @@map("inventory_parts")
}

// ─────────────────────────────────────────────
// CONSUMÍVEIS (Kits de reparo, boosts)
// ─────────────────────────────────────────────

model Consumable {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])

  consumableType ConsumableType
  value        Float           // ex: 25 para Kit 25%
  quantity     Int             @default(1)

  @@unique([userId, consumableType, value])
  @@map("consumables")
}

// ─────────────────────────────────────────────
// LOOTBOXES NO INVENTÁRIO
// ─────────────────────────────────────────────

model InventoryLootbox {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])

  lootboxType LootboxType
  quantity    Int         @default(1)
  source      String      // "purchased", "ranking", "mission", "weekly_drop"

  @@unique([userId, lootboxType])
  @@map("inventory_lootboxes")
}

// ─────────────────────────────────────────────
// MINERAÇÃO
// ─────────────────────────────────────────────

model MiningReward {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  token       Token
  amount      Float
  blockNumber Int
  createdAt   DateTime @default(now())

  @@index([userId])             // rewards history per user
  @@map("mining_rewards")
}

model MiningBlock {
  id              Int      @id @default(autoincrement())
  processedAt     DateTime @default(now())
  totalHashPower  Float
  rewardCrate     Float
  rewardSol       Float
  rewardLc        Float

  @@map("mining_blocks")
}

// ─────────────────────────────────────────────
// TRANSAÇÕES FINANCEIRAS
// ─────────────────────────────────────────────

model Transaction {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])

  type      TransactionType
  token     Token
  amount    Float
  txHash    String?
  status    TxStatus        @default(PENDING)
  createdAt DateTime        @default(now())

  @@index([userId])             // transaction history per user
  @@map("transactions")
}

model WithdrawRequest {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])

  token         Token
  amount        Float
  toAddress     String
  status        WithdrawStatus @default(PENDING)
  txHash        String?
  processedAt   DateTime?
  createdAt     DateTime      @default(now())

  @@map("withdraw_requests")
}

// ─────────────────────────────────────────────
// MERCADO INTERNO P2P
// ─────────────────────────────────────────────

model MarketListing {
  id            String        @id @default(uuid())
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id])

  itemType      MarketItemType
  price         Float         // em CRATE
  status        ListingStatus @default(ACTIVE)
  expiresAt     DateTime
  createdAt     DateTime      @default(now())

  // Apenas um dos itens abaixo será preenchido
  robotId       String?       @unique
  equipmentId   String?       @unique
  baseUpgradeId String?       @unique

  robot         Robot?        @relation(fields: [robotId], references: [id])
  equipment     Equipment?    @relation(fields: [equipmentId], references: [id])
  baseUpgrade   BaseUpgrade?  @relation(fields: [baseUpgradeId], references: [id])

  purchase      MarketPurchase?

  @@index([status])             // browse active listings
  @@index([sellerId, status])   // my listings
  @@map("market_listings")
}

model MarketPurchase {
  id          String        @id @default(uuid())
  listingId   String        @unique
  listing     MarketListing @relation(fields: [listingId], references: [id])
  buyerId     String
  buyer       User          @relation(fields: [buyerId], references: [id])

  pricePaid   Float
  fee         Float         // 5% da transação
  createdAt   DateTime      @default(now())

  @@map("market_purchases")
}

// ─────────────────────────────────────────────
// CODEX
// ─────────────────────────────────────────────

model CodexEntry {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])

  itemType      CodexItemType
  itemName      String      // nome do item registrado (preservado após remoção do inventário)
  collection    String
  rarity        Rarity
  registeredAt  DateTime    @default(now())

  // Apenas um preenchido
  robotId       String?     @unique
  equipmentId   String?     @unique
  baseUpgradeId String?     @unique

  robot         Robot?      @relation(fields: [robotId], references: [id])
  equipment     Equipment?  @relation(fields: [equipmentId], references: [id])
  baseUpgrade   BaseUpgrade? @relation(fields: [baseUpgradeId], references: [id])

  @@map("codex_entries")
}

model CodexCollection {
  id            String        @id @default(uuid())
  name          String        @unique   // deve corresponder ao campo collection dos robôs
  description   String
  itemType      CodexItemType @default(ROBOT)
  totalRequired Int           // quantidade de itens para completar a coleção

  // Bônus individual (por item registrado)
  bonusPerItemErPct  Float    @default(0)   // % ER global por item registrado

  // Bônus de completude (quando count >= totalRequired)
  completionErPct    Float    @default(0)   // % ER global adicional
  completionPdPct    Float    @default(0)   // % redução PD
  completionSlots    Int      @default(0)   // slots de outpost extras (one-time grant)
  completionTitle    String?               // título concedido ao completar (opcional)

  active         Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())

  @@map("codex_collections")
}

// Rastreia quais bônus de completude (slots) já foram concedidos — evita dupla concessão
model CodexCompletionReward {
  id             String   @id @default(uuid())
  userId         String
  collectionName String
  grantedAt      DateTime @default(now())

  @@unique([userId, collectionName])
  @@map("codex_completion_rewards")
}

// ─────────────────────────────────────────────
// MISSÕES
// ─────────────────────────────────────────────

model Mission {
  id          String          @id @default(uuid())
  title       String
  description String
  category    MissionCategory
  target      Int             // valor alvo (ex: 10 para "abrir 10 lootboxes")
  isSeasonal  Boolean         @default(false)
  expiresAt   DateTime?
  rewardType  RewardType
  rewardData  Json            // dados da recompensa

  userMissions UserMission[]

  @@map("missions")
}

model UserMission {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  missionId   String
  mission     Mission   @relation(fields: [missionId], references: [id])

  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  claimedAt   DateTime?

  @@unique([userId, missionId])
  @@map("user_missions")
}

// ─────────────────────────────────────────────
// MINIGAMES
// ─────────────────────────────────────────────

model MinigameSession {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])

  gameType      GameType
  won           Boolean
  score         Int
  difficulty    Int       @default(1)
  startedAt     DateTime  // registrado no início — valida tempo mínimo no servidor
  playedAt      DateTime  @default(now())

  // Recompensa (populada pelo /complete, aplicada pelo /claim)
  erBoost       Float?    // ER flat concedido por esta vitória
  pendingDrop   Json?     // { dropType, rarity, value } ou null
  claimed       Boolean   @default(false)
  claimedAt     DateTime?

  @@index([userId, claimed])    // claim route lookup
  @@map("minigame_sessions")
}

// Cada vitória gera uma entrada independente com duração própria
// Total ativo = soma das entradas com expiresAt > now
model MinigameBoost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  erFlat    Float    // ER flat desta vitória específica
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("minigame_boosts")
}

// Status por (jogador × jogo) — cooldown e contadores diários
model MinigameStatus {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  gameType         GameType

  gamesPlayedToday Int       @default(0)
  totalGamesPlayed Int       @default(0)
  dailyWins        Int       @default(0)
  nextPlayableAt   DateTime? // cooldown per-game (não global)
  lastResetAt      DateTime  @default(now())
  lastPlayedAt     DateTime?
  pendingToken     String?
  pendingStartedAt DateTime?

  @@unique([userId, gameType])
  @@map("minigame_statuses")
}

// ─────────────────────────────────────────────
// SHOP (catálogo gerenciado pelo admin)
// ─────────────────────────────────────────────

model ShopItem {
  id          String   @id   // mesmo ID de shop-items.ts (ex: 'robot-common')
  category    String
  name        String
  description String
  price       Float          // preço atual em CRATE — editável pelo admin
  rarity      String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Metadados específicos por tipo (gerado, bateria, slot, inventário)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("shop_items_config")
}

// ─────────────────────────────────────────────
// LOOTBOX CONFIG (drop tables gerenciadas pelo admin)
// ─────────────────────────────────────────────

model LootboxConfig {
  id          String      @id @default(uuid())
  lootboxType String      // PARTS_CRATE, SUPPLY_CRATE, ou nome de evento sazonal
  name        String
  description String
  priceCrate  Float       @default(0.01)
  weeklyLimit Int?        // null = ilimitado
  active      Boolean     @default(true)
  seasonal    Boolean     @default(false)
  startsAt    DateTime?   // para eventos sazonais
  endsAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  dropEntries LootboxDropEntry[]

  @@map("lootbox_configs")
}

model LootboxDropEntry {
  id             String        @id @default(uuid())
  lootboxConfigId String
  lootboxConfig  LootboxConfig @relation(fields: [lootboxConfigId], references: [id], onDelete: Cascade)

  // O que dropa
  dropType    LootboxDropType
  rarity      Rarity?         // para peças, equipamentos, robôs e base upgrades aleatórios
  minQuantity Int             @default(1)
  maxQuantity Int             @default(1)

  // Peso relativo (admin define; sistema normaliza para %)
  weight      Float           @default(1)

  // Item específico (futuro — para itens únicos definidos pelo admin)
  specificName String?

  @@map("lootbox_drop_entries")
}

// ─────────────────────────────────────────────
// CRAFTING (banco de dados — gerenciado pelo admin)
// ─────────────────────────────────────────────

model CraftingRecipe {
  id          String   @id @default(uuid())
  name        String
  description String
  active      Boolean  @default(true)

  // Custo e tempo — ajustáveis pelo admin sem deploy
  costCrate       Float @default(0)   // CRATE necessário para iniciar
  craftingTimeSec Int   @default(0)   // 0 = instantâneo

  // Output
  outputType        CraftOutputType
  outputName        String
  outputRarity      Rarity
  outputCollection  String?
  outputHashPower   Float?
  outputEnergyRate  Float?
  outputEffectType  EffectType?
  outputEffectValue Float?
  outputEffectType2 EffectType?
  outputEffectValue2 Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients   CraftingIngredient[]
  pendingCrafts PendingCraft[]

  @@map("crafting_recipes")
}

model CraftingIngredient {
  id       String         @id @default(uuid())
  recipeId String
  recipe   CraftingRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  partType String
  rarity   Rarity
  quantity Int

  @@map("crafting_ingredients")
}

// Craft em andamento — criado ao iniciar, coletado quando completo
model PendingCraft {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  recipeId   String
  recipe     CraftingRecipe @relation(fields: [recipeId], references: [id])

  startedAt   DateTime @default(now())
  completesAt DateTime
  claimed     Boolean  @default(false)
  claimedAt   DateTime?

  @@map("pending_crafts")
}

// ─────────────────────────────────────────────
// RANKING SEMANAL
// ─────────────────────────────────────────────

model WeeklySnapshot {
  id        String   @id @default(uuid())
  weekStart DateTime @unique
  entries   Json     // [{ userId, username, position, erTotal, rewarded }]
  createdAt DateTime @default(now())

  @@map("weekly_snapshots")
}

// ─────────────────────────────────────────────
// WEEKLY DROP
// ─────────────────────────────────────────────

model WeeklyDrop {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  weekStart   DateTime
  dropped     Boolean  @default(false)
  droppedAt   DateTime?
  reward      Json?

  @@unique([userId, weekStart])
  @@map("weekly_drops")
}

// ─────────────────────────────────────────────
// NOTIFICAÇÕES
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])       // bell unread count + list
  @@map("notifications")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum EffectType {
  HASH_POWER_FLAT
  HASH_POWER_PCT
  DURABILITY_LOSS_PCT
  GLOBAL_EFFICIENCY_PCT
  UPTIME_HOURS
  POWER_DRAW_FLAT        // reduz PD em valor absoluto
  POWER_DRAW_PCT         // reduz PD em percentual
}

enum PartCategory {
  ENERGY
  MINING
  MAINTENANCE
  TERRAIN
  AI_SOFTWARE
  SPECIAL
}

enum ConsumableType {
  REPAIR_KIT
  BOOST_TEMP
}

enum LootboxType {
  PARTS_CRATE
  SUPPLY_CRATE
}

enum Token {
  CRATE
  SOL
  LC
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  LOOTBOX_PURCHASE
  SHOP_PURCHASE
  MARKET_SALE
  MARKET_PURCHASE
  MINING_REWARD
  CONVERSION
  WEEKLY_DROP
  MISSION_REWARD
  RANKING_REWARD
}

enum TxStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum WithdrawStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MarketItemType {
  ROBOT
  EQUIPMENT
  BASE_UPGRADE
  PARTS_CRATE
  SUPPLY_CRATE
  CONSUMABLE
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  CANCELLED
}

enum CodexItemType {
  ROBOT
  EQUIPMENT
  BASE_UPGRADE
}

enum MissionCategory {
  FIRST_STEPS
  MINING
  LOOTBOX
  CRAFTING
  MARKET
  MINIGAMES
  CODEX
  RANKING
  SEASONAL
}

enum RewardType {
  LOOTBOX
  ROBOT
  EQUIPMENT
  REPAIR_KIT
  INVENTORY_EXPANSION
  COSMETIC
  TITLE
  OUTPOST_SLOT
}

enum GameType {
  SPACE_DRIFT
  BLOCK_FALL
  SERPENTINE
  ORBITAL_JUMP
  SPACE_FROG
}

enum CraftOutputType {
  ROBOT
  EQUIPMENT
  BASE_UPGRADE
}

enum LootboxDropType {
  ROBOT
  EQUIPMENT
  BASE_UPGRADE
  PART
  CONSUMABLE
}
